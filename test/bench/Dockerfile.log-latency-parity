# Runs the stream log-latency sort parity benchmark inside a container, so the
# numbers come from pinned CPUs and memory rather than whatever the host is
# doing. The fixture writes a real log stream (service/latency/level/body, with
# latency indexed) into a real TSDB on disk, so both sort paths read files
# rather than a warm memtable.
FROM golang:1.25-alpine

# Fixed CPU count: the benchmark compares two sort paths, so the machine has to
# stay the same for both. GOMAXPROCS is set at run time as well, because the Go
# runtime reads it, not the cgroup quota.
ENV CGO_ENABLED=0 \
    GOFLAGS=-mod=mod \
    GOMAXPROCS=4

WORKDIR /src
COPY . /src

# Build the test binary ahead of the run so the measurement is not competing
# with compilation for CPU.
RUN go test -c -o /out/stream-bench ./banyand/stream/

ENTRYPOINT ["/out/stream-bench"]

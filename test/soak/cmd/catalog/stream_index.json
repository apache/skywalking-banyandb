[
  {
    "id": "series_exact_svc",
    "request": {
      "groups": [
        "soak-idx-fixture"
      ],
      "name": "sw",
      "limit": 50,
      "projection": {
        "tagFamilies": [
          {
            "name": "searchable",
            "tags": [
              "service_id",
              "pod",
              "level",
              "trace_id",
              "message"
            ]
          },
          {
            "name": "metrics",
            "tags": [
              "duration",
              "status_code",
              "byte_size"
            ]
          }
        ]
      },
      "criteria": {
        "condition": {
          "name": "service_id",
          "op": "BINARY_OP_EQ",
          "value": {
            "str": {
              "value": "svc-0000"
            }
          }
        }
      }
    },
    "note": "series index _id exact match; resolves to one series"
  },

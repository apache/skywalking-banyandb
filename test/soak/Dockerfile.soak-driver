# Multi-stage build: compile soak-driver from the local source tree so
# it always runs the same binary as the branch under test.

FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git make gcc musl-dev

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /out/soak-driver \
    ./cmd/soak-driver

FROM busybox:stable-glibc AS final

COPY --from=builder /out/soak-driver /soak-driver

# Catalog files are embedded at image build time so docker compose run
# invocations can refer to /catalog/* without a separate mount.
COPY cmd/soak-driver/catalog /catalog

ENTRYPOINT ["/soak-driver"]
